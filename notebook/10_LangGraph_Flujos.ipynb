<<<<<<< HEAD
    "# 6. Corrects if needed\n",
    "\n",
    "from typing import TypedDict, Literal\n",
    "from langgraph.graph import StateGraph, START, END\n",
    "\n",
    "\n",
    "class SupportFlowState(TypedDict):\n",
    "    question: str\n",
    "    question_type: str\n",
    "    context: str\n",
    "    response: str\n",
    "    quality_ok: bool\n",
    "    final_response: str\n",
    "\n",
    "\n",
    "def classify_support_question(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Classify the question into a simple routing category.\"\"\"\n",
    "    question = state[\"question\"].lower()\n",
    "\n",
    "    if any(word in question for word in [\"precio\", \"coste\", \"cuesta\", \"plan\"]):\n",
    "        question_type = \"pricing\"\n",
    "    elif any(word in question for word in [\"ibi\", \"ivtm\", \"impuesto\", \"bonificacion\", \"bonificación\"]):\n",
    "        question_type = \"tax\"\n",
    "    elif any(word in question for word in [\"horario\", \"contacto\", \"email\", \"telefono\", \"teléfono\"]):\n",
    "        question_type = \"support\"\n",
    "    else:\n",
    "        question_type = \"general\"\n",
    "\n",
    "    return {**state, \"question_type\": question_type}\n",
    "\n",
    "\n",
    "def retrieve_support_info(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Retrieve relevant information from the existing retriever.\"\"\"\n",
    "    docs_found = retriever.invoke(state[\"question\"])\n",
    "    context = \"\\n\".join(doc.page_content for doc in docs_found)\n",
    "\n",
    "    return {**state, \"context\": context}\n",
    "\n",
    "\n",
    "def generate_support_response(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Generate a response using the existing llm.\"\"\"\n",
    "    prompt = f\"\"\"Responde usando solo el contexto.\n",
    "\n",
    "Tipo de pregunta: {state[\"question_type\"]}\n",
    "\n",
    "Contexto:\n",
    "{state[\"context\"]}\n",
    "\n",
    "Pregunta:\n",
    "{state[\"question\"]}\n",
    "\n",
    "Respuesta:\"\"\"\n",
    "\n",
    "    response = llm.invoke(prompt)\n",
    "\n",
    "    return {**state, \"response\": response.content}\n",
    "\n",
    "\n",
    "def check_support_quality(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Check whether the answer is usable and grounded enough.\"\"\"\n",
    "    response = state[\"response\"].strip()\n",
    "    context = state[\"context\"].strip()\n",
    "\n",
    "    quality_ok = (\n",
    "        bool(context)\n",
    "        and len(response) >= 30\n",
    "        and \"no sé\" not in response.lower()\n",
    "        and \"no tengo\" not in response.lower()\n",
    "    )\n",
    "\n",
    "    return {**state, \"quality_ok\": quality_ok}\n",
    "\n",
    "\n",
    "def correct_support_response(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Fallback response when the generated answer is weak.\"\"\"\n",
    "    fallback = (\n",
    "        \"No tengo suficiente contexto para responder con seguridad. \"\n",
    "        \"Te recomiendo contactar con soporte o ampliar la base de conocimiento.\"\n",
    "    )\n",
    "\n",
    "    return {**state, \"final_response\": fallback}\n",
    "\n",
    "\n",
    "def finalize_support_response(state: SupportFlowState) -> SupportFlowState:\n",
    "    \"\"\"Use the generated answer as final response.\"\"\"\n",
    "    return {**state, \"final_response\": state[\"response\"]}\n",
    "\n",
    "\n",
    "def route_quality_check(state: SupportFlowState) -> Literal[\"finalize\", \"correct\"]:\n",
    "    \"\"\"Route depending on quality check.\"\"\"\n",
    "    return \"finalize\" if state[\"quality_ok\"] else \"correct\"\n",
    "\n",
    "\n",
    "# Build workflow\n",
    "support_workflow = StateGraph(SupportFlowState)\n",
    "\n",
    "support_workflow.add_node(\"classify\", classify_support_question)\n",
    "support_workflow.add_node(\"retrieve\", retrieve_support_info)\n",
    "support_workflow.add_node(\"generate\", generate_support_response)\n",
    "support_workflow.add_node(\"check\", check_support_quality)\n",
    "support_workflow.add_node(\"correct\", correct_support_response)\n",
    "support_workflow.add_node(\"finalize\", finalize_support_response)\n",
    "\n",
    "support_workflow.add_edge(START, \"classify\")\n",
    "support_workflow.add_edge(\"classify\", \"retrieve\")\n",
    "support_workflow.add_edge(\"retrieve\", \"generate\")\n",
    "support_workflow.add_edge(\"generate\", \"check\")\n",
    "\n",
    "support_workflow.add_conditional_edges(\n",
    "    \"check\",\n",
    "    route_quality_check,\n",
    "    {\n",
    "        \"finalize\": \"finalize\",\n",
    "        \"correct\": \"correct\",\n",
    "    },\n",
    ")\n",
    "\n",
    "support_workflow.add_edge(\"finalize\", END)\n",
    "support_workflow.add_edge(\"correct\", END)\n",
    "\n",
    "support_app = support_workflow.compile()\n",
