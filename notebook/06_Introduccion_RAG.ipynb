    "# Step 4: Setup LLM (usando modelo local sin API key)\n",
    "from transformers import pipeline\n",
    "from langchain_core.messages import AIMessage\n",
    "\n",
    "print(\"Cargando modelo de lenguaje local (GPT-2)...\")\n",
    "\n",
    "# Crear un pipeline de text generation simple pero efectivo\n",
    "llm_pipeline = pipeline(\n",
    "    \"text-generation\",\n",
    "    model=\"gpt2\",\n",
    "    device=-1  # -1 para CPU, 0+ para GPU si disponible\n",
    ")\n",
    "\n",
    "class LocalLLMWrapper:\n",
    "    \"\"\"Wrapper para usar el pipeline como LLM en LangChain\"\"\"\n",
    "    def __init__(self, pipeline):\n",
    "        self.pipeline = pipeline\n",
    "    \n",
    "    def invoke(self, messages):\n",
    "        \"\"\"Invoke the LLM con formato de LangChain\"\"\"\n",
    "        # Extraer el texto del último mensaje\n",
    "        if isinstance(messages, list):\n",
    "            text = messages[-1].content if hasattr(messages[-1], 'content') else str(messages[-1])\n",
    "        else:\n",
    "            text = str(messages)\n",
    "        \n",
    "        # Generar respuesta\n",
    "        response = self.pipeline(\n",
    "            text,\n",
    "            max_new_tokens=120,\n",
    "            do_sample=True,\n",
    "            temperature=0.7,\n",
    "            pad_token_id=self.pipeline.tokenizer.eos_token_id,\n",
    "            return_full_text=False\n",
    "        )\n",
    "        answer = response[0]['generated_text'].strip()\n",
    "        \n",
    "        return AIMessage(content=answer if answer else \"No pude generar una respuesta con el contexto dado.\")\n",
    "\n",
    "llm = LocalLLMWrapper(llm_pipeline)\n",
    "print(\"✓ LLM local configurado (sin necesidad de API key)\")"
   ]
